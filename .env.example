# Copier vers .env.local. Aucun accès n'est fourni dans le dépôt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret exclusivement côté serveur et scripts admin :
SUPABASE_SECRET_KEY=
# Domaine que VOUS contrôlez, réservé aux identités techniques (ex. auth.votredomaine.fr).
AUTH_IDENTITY_DOMAIN=
# Secret aléatoire >= 32 caractères pour hacher les clés de limitation des connexions.
LOGIN_RATE_SECRET=
# URL exacte de l'application, localhost autorisé en développement.
APP_ORIGIN=http://127.0.0.1:3000
